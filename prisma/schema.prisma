// WEB OPS — Digital Facility Operations & Compliance Platform
// Schema is organised into: Identity & Access, Facility Hierarchy,
// Checklist Definition & Versioning, Scheduling, Verification Workflow,
// Inspections & Responses, Evidence, Findings & Corrective Actions,
// Area Release, Notifications, Audit Trail.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =========================================================================
// IDENTITY & ACCESS
// =========================================================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  OPERATOR
  TEAM_LEADER
  SUPERVISOR
  QA
  MANAGEMENT
  VIEWER
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  passwordHash  String
  employeeId    String?  @unique
  role          UserRole
  jobTitle      String?
  phone         String?
  active        Boolean  @default(true)
  sectionId     String?
  section       Section? @relation(fields: [sectionId], references: [id])
  // Area-level access scope (spec: section staff only see their own areas'
  // tasks). Distinct from sectionId above, which is only a display/record
  // field - assignedAreas is what actually restricts visibility. An
  // OPERATOR/TEAM_LEADER/SUPERVISOR can be assigned one or more areas (some
  // work across multiple sections, e.g. a team leader covering both
  // Capsule Room and Bottling); every other role, and any of those three
  // roles left with zero areas assigned (e.g. a floor-wide "Production
  // Supervisor"), sees everything. See lib/scope.ts.
  assignedAreas Area[]   @relation("UserAssignedAreas")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  operatorInspections       Inspection[]            @relation("OperatorInspections")
  supervisorInspections     Inspection[]            @relation("SupervisorInspections")
  qaInspections             Inspection[]            @relation("QaInspections")
  scheduleAssignments       ChecklistSchedule[]
  photoUploads              PhotoEvidence[]
  findingsCreated           Finding[]               @relation("FindingCreatedBy")
  correctiveActionsOwned    CorrectiveAction[]      @relation("CorrectiveActionResponsible")
  correctiveActionsClosed   CorrectiveAction[]      @relation("CorrectiveActionClosedBy")
  correctiveActionsVerified CorrectiveAction[]      @relation("CorrectiveActionVerifiedBy")
  verificationRecords       VerificationRecord[]
  areaReleaseSupervised     AreaRelease[]           @relation("AreaReleaseSupervisor")
  areaReleaseQaVerified     AreaRelease[]           @relation("AreaReleaseQa")
  notifications             Notification[]
  notificationRecipientOf   NotificationRecipient[]
  auditLogEntries           AuditLog[]
  checklistVersionsCreated  ChecklistVersion[]
  respondedItems            InspectionResponse[]
  calibrationsRecorded      EquipmentCalibration[]
  capsuleCalculations       CapsuleCalculation[]
  mfgBatches                MfgBatch[]
  qcSamplesCollected        QcSample[]              @relation("QcSampleCollectedBy")
  qcSamplesReceived         QcSample[]              @relation("QcSampleReceivedBy")
  qcSamplesCreated          QcSample[]              @relation("QcSampleCreatedBy")
  qcLabTestsPerformed       QcLabTest[]
  qcAttachmentsUploaded     QcSampleAttachment[]
  formulationsCreated       Formulation[]
  dryingBaysAssigned        DryingBay[]             @relation("DryingBayAssignedEmployee")
  dryingBatchesAssigned     DryingBatch[]           @relation("DryingBatchAssignedEmployee")
  dryingTrolleysAssigned    DryingTrolley[]         @relation("DryingTrolleyAssignedEmployee")

  @@index([role])
}

// =========================================================================
// FACILITY HIERARCHY — configurable, not hard-coded
// FACILITY -> SECTION -> AREA -> EQUIPMENT
// =========================================================================

model Facility {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  address   String?
  timezone  String   @default("Australia/Brisbane")
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections           Section[]
  checklistSchedules ChecklistSchedule[]
  inspections        Inspection[]
}

model Section {
  id         String   @id @default(cuid())
  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  name       String
  code       String
  sortOrder  Int      @default(0)
  archived   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  areas              Area[]
  checklistSchedules ChecklistSchedule[]
  users              User[]
  inspections        Inspection[]

  @@unique([facilityId, code])
}

model Area {
  id        String   @id @default(cuid())
  sectionId String
  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  name      String
  code      String
  sortOrder Int      @default(0)
  archived  Boolean  @default(false)
  qrToken   String   @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  equipment          Equipment[]
  checklistSchedules ChecklistSchedule[]
  inspections        Inspection[]
  assignedUsers      User[]              @relation("UserAssignedAreas")
  findings           Finding[]
  photoEvidence      PhotoEvidence[]
  correctiveActions  CorrectiveAction[]
  areaReleases       AreaRelease[]

  @@unique([sectionId, code])
}

model Equipment {
  id           String   @id @default(cuid())
  areaId       String
  area         Area     @relation(fields: [areaId], references: [id], onDelete: Cascade)
  name         String
  code         String
  serialNumber String?
  sortOrder    Int      @default(0)
  archived     Boolean  @default(false)
  qrToken      String   @unique @default(cuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Equipment register detail -- all optional so nothing that already exists
  // (or gets added by hand through the admin form) needs to carry them.
  // Dates are kept as plain strings, not DateTime: real register data mixes
  // real dates with "TBC"/"N/A"/prose ("before 31/10/2026"), which a strict
  // date column can't hold without losing information.
  manufacturerModel String?
  criticality       String? // e.g. "Critical", "Major", "Minor", "Critical (CCP)"
  foodSafetyRisk    Boolean?
  ppmFrequency      String?
  serviceProvider   String?
  status            String? // e.g. "Active", "Retired 18/06/2026" -- free text, not an enum, since real records carry a reason/date inline
  lastServiceDate   String?
  nextServiceDue    String?
  validationStatus  String?
  comments          String?

  checklistSchedules ChecklistSchedule[]
  inspections        Inspection[]
  findings           Finding[]
  photoEvidence      PhotoEvidence[]
  correctiveActions  CorrectiveAction[]
  calibrations       EquipmentCalibration[]

  @@unique([areaId, code])
}

// =========================================================================
// EQUIPMENT CALIBRATION TRACKING — one row per calibration event; the most
// recent row per equipment (by calibratedDate) is what's "current". Status
// (CURRENT/DUE_SOON/OVERDUE) is deliberately not a stored column — it's
// derived from dueDate at read time (lib/calibration.ts), same convention
// CorrectiveAction.status uses for OVERDUE (computed via isPast(dueDate) in
// the UI, not persisted) so it can never drift from "today".
// =========================================================================

model EquipmentCalibration {
  id          String    @id @default(cuid())
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  calibratedDate DateTime
  // Stored (not just re-derived from a facility-wide default) so the next
  // reminder for *this* equipment doesn't require re-asking every time -
  // different instruments legitimately have different calibration intervals.
  intervalDays   Int
  dueDate        DateTime

  // External vendor/technician name - calibration is almost always performed
  // by a third party, not a WEB OPS User, so this is a plain string rather
  // than a User relation.
  performedBy       String
  certificateNumber String?
  certificateUrl    String? // Vercel Blob URL, same storage as PhotoEvidence
  notes             String?

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([equipmentId, calibratedDate])
  @@index([dueDate])
}

// =========================================================================
// CAPSULE/BOTTLE PRODUCTION PLANNING CALCULATOR — a standalone "what-if"
// math tool (kg <-> capsules <-> bottles), not tied to any specific
// Facility/Area/Equipment or Inspection. Every run is logged so the running
// history stays available, same "log every mutation" spirit as AuditLog,
// but kept as its own table (rather than an AuditLog entry) since a
// calculation is itself a first-class record someone may want to revisit,
// not just a side-effect of some other action.
// =========================================================================

enum CalculationDirection {
  BOTTLES_TO_KG
  KG_TO_OUTPUT
  // Post-encapsulation: a bag/bucket of finished (pressed) capsules weighed
  // in kg -> capsule count & bottle output. Same kg<->capsules math as
  // KG_TO_OUTPUT, but the weight figure is the capsule's average FULL
  // weight (shell + fill), not the fill weight alone -- a different real
  // quantity, so kept as its own direction rather than merged with
  // KG_TO_OUTPUT. See lib/capsule-calculation.ts for the shared formula and
  // per-direction field labels.
  BAGGED_KG_TO_OUTPUT
  // The reverse of KG_TO_OUTPUT: a known capsule count -> empty shell weight
  // (kg) + boxes of empty shells to buy. `capsulesPerBottle` is reused here
  // to mean capsules-per-box (bulk purchasing unit), and the box count is
  // rounded UP (you can't buy a partial box), unlike the floor/round-down
  // used for bottle counts elsewhere.
  CAPSULES_TO_SHELLS
  // Gummies: a finished batch's actual weighed output (kg) -> gummy piece
  // count & pouch/bottle output. Same kg<->pieces math as KG_TO_OUTPUT
  // (`avgWeightMg` is the weight of one gummy, `capsulesPerBottle` is
  // pieces-per-pouch or pieces-per-bottle) -- kept as separate directions
  // purely for distinct field labels/defaults, not a different formula.
  KG_TO_GUMMY_POUCHES
  KG_TO_GUMMY_BOTTLES
}

model CapsuleCalculation {
  id                String               @id @default(cuid())
  direction         CalculationDirection
  label             String?
  productName       String?
  batchNumber       String?
  // Capsules-per-bottle for every direction except CAPSULES_TO_SHELLS,
  // where it means capsules-per-box instead -- same "meaning depends on
  // direction" reuse as avgWeightMg below.
  capsulesPerBottle Int
  // The weight figure this calculation used -- fill weight for
  // BOTTLES_TO_KG/KG_TO_OUTPUT, full (shell+fill) weight for
  // BAGGED_KG_TO_OUTPUT, empty shell weight for CAPSULES_TO_SHELLS. Which
  // one it is is derived from `direction` at read time, not stored as a
  // separate column (spec: "tag each row's weight figure as fill/full/shell
  // depending on which mode it came from").
  avgWeightMg       Float
  // The one given input: target bottle count for BOTTLES_TO_KG, capsule
  // count for CAPSULES_TO_SHELLS, or kg for
  // the other two directions.
  inputValue        Float
  resultKg          Float
  resultCapsules    Float
  resultBottles     Float

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// =========================================================================
// VERIFICATION WORKFLOW — configurable per checklist, not hard-coded
// e.g. Operator -> Supervisor -> QA, or Operator -> Supervisor only
// =========================================================================

enum WorkflowRole {
  OPERATOR
  TEAM_LEADER
  SUPERVISOR
  QA
}

model VerificationWorkflow {
  id                  String   @id @default(cuid())
  name                String
  description         String?
  requiresAreaRelease Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  steps      VerificationStep[]
  checklists Checklist[]
}

model VerificationStep {
  id         String               @id @default(cuid())
  workflowId String
  workflow   VerificationWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  order      Int
  role       WorkflowRole

  @@unique([workflowId, order])
}

// =========================================================================
// CHECKLIST DEFINITION & VERSION CONTROL
// =========================================================================

enum ChecklistCategory {
  PRE_START
  LINE_CLEARANCE
  POST_OPERATION_CLEANING
  FIVE_S
  EQUIPMENT_CHECK
  FACILITY_INSPECTION
  WAREHOUSE_INSPECTION
  PER_SHIFT
  CUSTOM
}

enum Frequency {
  PER_SHIFT
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  AD_HOC
  BEFORE_PRODUCTION
  AFTER_PRODUCTION
  AFTER_CLEANING
  AFTER_MAINTENANCE
}

enum ItemType {
  PASS_FAIL
  YES_NO
  NA
  NUMERIC
  TEXT
  PHOTO
  MULTIPLE_CHOICE
  ACKNOWLEDGEMENT
}

model Checklist {
  id          String                @id @default(cuid())
  name        String
  category    ChecklistCategory
  description String?
  workflowId  String?
  workflow    VerificationWorkflow? @relation(fields: [workflowId], references: [id])
  active      Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  versions  ChecklistVersion[]
  schedules ChecklistSchedule[]
}

model ChecklistVersion {
  id            String    @id @default(cuid())
  checklistId   String
  checklist     Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  versionNumber String // e.g. "1.0", "1.1"
  publishedAt   DateTime  @default(now())
  createdById   String
  createdBy     User      @relation(fields: [createdById], references: [id])
  isCurrent     Boolean   @default(true)

  items       ChecklistItem[]
  inspections Inspection[]

  @@unique([checklistId, versionNumber])
}

model ChecklistItem {
  id                  String           @id @default(cuid())
  checklistVersionId  String
  checklistVersion    ChecklistVersion @relation(fields: [checklistVersionId], references: [id], onDelete: Cascade)
  groupLabel          String // e.g. "PRODUCT CLEARANCE", "SORT", "EQUIPMENT"
  sortOrder           Int              @default(0)
  prompt              String
  helpText            String?
  type                ItemType
  required            Boolean          @default(true)
  choices             Json? // for MULTIPLE_CHOICE: string[]
  minValue            Float?
  maxValue            Float?
  requiresPhotoOnFail Boolean          @default(false)
  criticalFailure     Boolean          @default(false) // FAIL here forces severity >= MAJOR

  responses InspectionResponse[]
  findings  Finding[]

  @@index([checklistVersionId])
}

// =========================================================================
// SCHEDULING ENGINE — generates recurring Inspection instances
// =========================================================================

model ChecklistSchedule {
  id          String    @id @default(cuid())
  checklistId String
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  frequency      Frequency
  startDate      DateTime
  endDate        DateTime?
  dueTime        String? // "HH:mm" local facility time
  dueWindowMins  Int       @default(120)
  // Recurrence detail: for WEEKLY, day-of-week 0-6 (Sun-Sat); for MONTHLY, day-of-month or "first working day"
  recurrenceDays Int[]     @default([])

  facilityId  String
  facility    Facility   @relation(fields: [facilityId], references: [id])
  sectionId   String?
  section     Section?   @relation(fields: [sectionId], references: [id])
  areaId      String?
  area        Area?      @relation(fields: [areaId], references: [id])
  equipmentId String?
  equipment   Equipment? @relation(fields: [equipmentId], references: [id])

  assignedRole   UserRole?
  assignedUserId String?
  assignedUser   User?     @relation(fields: [assignedUserId], references: [id])

  priority      Priority @default(NORMAL)
  photoRequired Boolean  @default(false)
  active        Boolean  @default(true)

  lastGeneratedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inspections Inspection[]

  @@index([facilityId, active])
}

enum Priority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

// =========================================================================
// INSPECTIONS — one instance of a checklist being carried out
// =========================================================================

enum InspectionStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  AWAITING_SUPERVISOR
  SUPERVISOR_APPROVED
  AWAITING_QA
  QA_APPROVED
  CLOSED
  RETURNED
  REJECTED
  OVERDUE
}

model Inspection {
  id                 String             @id @default(cuid())
  checklistVersionId String
  checklistVersion   ChecklistVersion   @relation(fields: [checklistVersionId], references: [id])
  scheduleId         String?
  schedule           ChecklistSchedule? @relation(fields: [scheduleId], references: [id])

  facilityId  String
  facility    Facility   @relation(fields: [facilityId], references: [id])
  sectionId   String?
  section     Section?   @relation(fields: [sectionId], references: [id])
  areaId      String?
  area        Area?      @relation(fields: [areaId], references: [id])
  equipmentId String?
  equipment   Equipment? @relation(fields: [equipmentId], references: [id])

  frequency   Frequency
  priority    Priority  @default(NORMAL)
  shift       String?
  product     String?
  batchNumber String?

  status InspectionStatus @default(NOT_STARTED)
  score  Float? // % pass rate at close

  dueAt       DateTime?
  startedAt   DateTime?
  submittedAt DateTime?

  operatorId   String?
  operator     User?   @relation("OperatorInspections", fields: [operatorId], references: [id])
  supervisorId String?
  supervisor   User?   @relation("SupervisorInspections", fields: [supervisorId], references: [id])
  qaId         String?
  qa           User?   @relation("QaInspections", fields: [qaId], references: [id])

  returnedReason String?
  rejectedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responses           InspectionResponse[]
  photoEvidence       PhotoEvidence[]
  findings            Finding[]
  verificationRecords VerificationRecord[]
  areaRelease         AreaRelease?
  auditLogEntries     AuditLog[]

  @@index([facilityId, status])
  @@index([areaId, status])
  @@index([dueAt])
}

model InspectionResponse {
  id              String        @id @default(cuid())
  inspectionId    String
  inspection      Inspection    @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  checklistItemId String
  checklistItem   ChecklistItem @relation(fields: [checklistItemId], references: [id])

  passFail     ResponseValue?
  numericValue Float?
  textValue    String?
  choiceValue  String?
  comment      String?

  // Who actually ticked this specific item and when — distinct from the
  // Inspection's overall operatorId, since a supervisor/admin can fill in
  // items on someone else's behalf and GMP forms expect per-task attribution
  // (e.g. "record operator initials" on several items in the real C-FORM-002
  // documents), not just one signature for the whole form.
  respondedById String?
  respondedBy   User?   @relation(fields: [respondedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photoEvidence PhotoEvidence[]
  finding       Finding?

  @@unique([inspectionId, checklistItemId])
}

enum ResponseValue {
  PASS
  FAIL
  NA
}

// =========================================================================
// PHOTO EVIDENCE — metadata only; binary lives in object storage (Vercel Blob)
// =========================================================================

enum PhotoKind {
  GENERAL
  BEFORE
  AFTER
}

model PhotoEvidence {
  id                 String              @id @default(cuid())
  inspectionId       String?
  inspection         Inspection?         @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  responseId         String?
  response           InspectionResponse? @relation(fields: [responseId], references: [id], onDelete: Cascade)
  findingId          String?
  // SetNull, not Cascade: a photo is durable evidence of what was observed —
  // it must survive even if the Finding bookkeeping row it was attached to
  // later gets deleted (e.g. an operator's auto-cleanup correction), per
  // spec §14 "never create orphaned photos" / never silently destroy evidence.
  finding            Finding?            @relation(fields: [findingId], references: [id], onDelete: SetNull)
  correctiveActionId String?
  correctiveAction   CorrectiveAction?   @relation(fields: [correctiveActionId], references: [id], onDelete: Cascade)

  areaId      String?
  area        Area?      @relation(fields: [areaId], references: [id])
  equipmentId String?
  equipment   Equipment? @relation(fields: [equipmentId], references: [id])

  kind          PhotoKind @default(GENERAL)
  storagePath   String // Vercel Blob URL
  thumbnailPath String?
  filename      String
  mimeType      String
  sizeBytes     Int
  caption       String?

  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([inspectionId])
  @@index([areaId])
  @@index([findingId])
}

// =========================================================================
// FINDINGS & CORRECTIVE ACTIONS
// =========================================================================

enum Severity {
  CRITICAL
  MAJOR
  MINOR
}

enum FindingStatus {
  OPEN
  CORRECTIVE_ACTION_CREATED
  CLOSED
}

model Finding {
  id              String              @id @default(cuid())
  inspectionId    String
  inspection      Inspection          @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  responseId      String?             @unique
  response        InspectionResponse? @relation(fields: [responseId], references: [id])
  checklistItemId String?
  checklistItem   ChecklistItem?      @relation(fields: [checklistItemId], references: [id])

  areaId      String?
  area        Area?      @relation(fields: [areaId], references: [id])
  equipmentId String?
  equipment   Equipment? @relation(fields: [equipmentId], references: [id])

  description         String
  reason              String?
  severity            Severity
  status              FindingStatus @default(OPEN)
  immediateCorrection String?

  createdById String
  createdBy   User     @relation("FindingCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  photoEvidence    PhotoEvidence[]
  correctiveAction CorrectiveAction?

  @@index([areaId, status])
  @@index([severity])
}

enum CorrectiveActionStatus {
  OPEN
  IN_PROGRESS
  AWAITING_VERIFICATION
  CLOSED
  OVERDUE
}

model CorrectiveAction {
  id        String  @id @default(cuid())
  findingId String  @unique
  finding   Finding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  areaId      String?
  area        Area?      @relation(fields: [areaId], references: [id])
  equipmentId String?
  equipment   Equipment? @relation(fields: [equipmentId], references: [id])

  rootCause           String?
  immediateCorrection String?
  correctiveAction    String
  preventiveAction    String?

  responsibleUserId String
  responsibleUser   User                   @relation("CorrectiveActionResponsible", fields: [responsibleUserId], references: [id])
  dueDate           DateTime
  status            CorrectiveActionStatus @default(OPEN)

  closedById String?
  closedBy   User?     @relation("CorrectiveActionClosedBy", fields: [closedById], references: [id])
  closedAt   DateTime?

  verifiedById String?
  verifiedBy   User?     @relation("CorrectiveActionVerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photoEvidence PhotoEvidence[]

  @@index([status, dueDate])
}

// =========================================================================
// THREE-LEVEL VERIFICATION — sign-off log (segregation of duties)
// =========================================================================

enum VerificationAction {
  APPROVE
  RETURN
  REJECT
}

model VerificationRecord {
  id           String             @id @default(cuid())
  inspectionId String
  inspection   Inspection         @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  stepRole     WorkflowRole
  actorId      String
  actor        User               @relation(fields: [actorId], references: [id])
  action       VerificationAction
  comment      String?
  createdAt    DateTime           @default(now())

  @@index([inspectionId])
}

// =========================================================================
// AREA RELEASE — controlled cleaning/production release
// =========================================================================

enum AreaReleaseStatus {
  NOT_RELEASED
  AWAITING_SUPERVISOR
  AWAITING_QA
  QA_RELEASED
}

model AreaRelease {
  id           String     @id @default(cuid())
  areaId       String
  area         Area       @relation(fields: [areaId], references: [id])
  inspectionId String     @unique
  inspection   Inspection @relation(fields: [inspectionId], references: [id])

  status       AreaReleaseStatus @default(NOT_RELEASED)
  supervisorId String?
  supervisor   User?             @relation("AreaReleaseSupervisor", fields: [supervisorId], references: [id])
  supervisorAt DateTime?
  qaId         String?
  qa           User?             @relation("AreaReleaseQa", fields: [qaId], references: [id])
  qaAt         DateTime?
  releasedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([areaId, status])
}

// =========================================================================
// NOTIFICATIONS
// =========================================================================

enum NotificationType {
  CHECK_DUE
  CHECK_OVERDUE
  SUPERVISOR_VERIFICATION_REQUIRED
  QA_VERIFICATION_REQUIRED
  CORRECTIVE_ACTION_DUE
  CORRECTIVE_ACTION_OVERDUE
  RETURNED
  REJECTED
  AREA_RELEASED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
}

// =========================================================================
// AUDIT TRAIL — immutable log of every state-changing action
// =========================================================================

enum AuditAction {
  CREATED
  STARTED
  EDITED
  SUBMITTED
  ITEM_FAILED
  PHOTO_UPLOADED
  FINDING_CREATED
  CORRECTIVE_ACTION_CREATED
  SUPERVISOR_REVIEWED
  SUPERVISOR_APPROVED
  RETURNED
  REJECTED
  QA_REVIEWED
  QA_APPROVED
  CLOSED
  LOGIN
  AREA_RELEASED
  DELETED
  QC_COLLECTED
  QC_SENT_TO_LAB
  QC_RECEIVED_AT_LAB
  QC_TESTING_STARTED
  QC_RESULTS_RECORDED
  QC_APPROVED
  QC_MOVED_TO_RETENTION
  QC_EXPIRED
  QC_DISPOSED
  QC_ATTACHMENT_ADDED
  QC_ATTACHMENT_REMOVED
  DRYING_STAGE_CHANGED
}

model AuditLog {
  id           String      @id @default(cuid())
  entityType   String // "Inspection" | "CorrectiveAction" | "Finding" | ...
  entityId     String
  inspectionId String?
  inspection   Inspection? @relation(fields: [inspectionId], references: [id])
  action       AuditAction
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  oldValue     Json?
  newValue     Json?
  reason       String?
  createdAt    DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([inspectionId])
}

// =========================================================================
// SYSTEM SETTINGS — facility-wide branding, photo limits, notification
// routing. Singleton config: exactly one SystemSettings row is expected to
// ever exist, looked up via findFirst() rather than a fixed known id.
// =========================================================================

model SystemSettings {
  id               String   @id @default(cuid())
  organizationName String?
  logoUrl          String? // Vercel Blob URL, same storage as PhotoEvidence
  maxPhotoSizeMb   Int      @default(10) // mirrors lib/storage.ts's current hardcoded MAX_PHOTO_BYTES
  updatedAt        DateTime @updatedAt
}

// One row per NotificationType, created on demand — a missing row means
// "enabled" (the current, hardcoded behaviour), so existing notification
// types don't need backfilling when this table is introduced.
model NotificationSetting {
  type      NotificationType @id
  enabled   Boolean          @default(true)
  updatedAt DateTime         @updatedAt
}

// Additional recipients for a notification type, on top of whatever the
// triggering code already targets (a role broadcast or a specific person).
model NotificationRecipient {
  id        String           @id @default(cuid())
  type      NotificationType
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@unique([type, userId])
  @@index([type])
}

// =========================================================================
// MANUFACTURING RECONCILIATION — end-to-end GMP-style batch traceability:
// Warehouse Issue -> Blending -> Encapsulation -> Bottling -> X-Ray/Metal
// Detection -> Packaging -> Finished Goods Warehouse -> Dispatch. Each
// stage is its own optional record, filled in independently as production
// reaches it. Yield/balance/reconciliation % figures are always computed
// at read time from the raw quantities stored here (lib/mfg-reconciliation.ts)
// -- never persisted, same "derive don't store" convention as
// EquipmentCalibration's status and CorrectiveAction's OVERDUE state.
//
// Every "who did this" field below (issuedBy, blendedBy, completedBy,
// checkedBy, inspectedBy, packedBy, qaReleasedBy, dispatchedBy) is a plain
// name string, not a User relation -- these mirror the real paper GMP
// forms' signature fields, which record whoever physically performed that
// step on the floor. That person may not have (or need) a WebOps login,
// and the name entered has to match what's on the physical record, so it
// can't be constrained to "an actual system user" the way MfgBatch's own
// createdBy is. Who actually *saved* each stage in this system is already
// captured per edit in AuditLog (entityType "MfgBatch"), so there's no
// accountability gap from these being plain text.
// =========================================================================

enum MfgBatchStatus {
  IN_PROGRESS
  COMPLETED
}

enum MfgMaterialGroup {
  RAW_INGREDIENT
  RAW_ACTIVE_INGREDIENT
  RAW_EXCIPIENT
  PACKAGING_EMPTY_CAPSULE
  PACKAGING_EMPTY_BOTTLE
  PACKAGING_CAP
  PACKAGING_DESICCANT
  PACKAGING_LABEL
  PACKAGING_CARTON
  PACKAGING_INSERT
  PACKAGING_SHRINK_WRAP
  PACKAGING_SHIPPER
  PACKAGING_PALLET
}

enum MfgPackagingMaterialType {
  LABEL
  CARTON
  INSERT
  SHRINK_WRAP
  SHIPPER
}

model MfgBatch {
  id                   String  @id @default(cuid())
  batchNumber          String
  productName          String
  // This project has no first-class Formulation/BOM/BatchRecord module to
  // link to (unlike the reference implementation this feature is adapted
  // from) -- kept as a free-text reference note instead of a relation.
  formulationReference String?

  status  MfgBatchStatus @default(IN_PROGRESS)
  remarks String?

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  warehouseIssue         MfgWarehouseIssue?
  blending               MfgBlending?
  encapsulation          MfgEncapsulation?
  bottling               MfgBottling?
  xrayInspection         MfgXrayInspection?
  packaging              MfgPackaging?
  finishedGoodsWarehouse MfgFinishedGoodsWarehouse?
  dispatchEvents         MfgDispatchEvent[]
  qcSamples              QcSample[]

  @@index([batchNumber])
  @@index([status])
}

model MfgWarehouseIssue {
  id         String   @id @default(cuid())
  mfgBatchId String   @unique
  mfgBatch   MfgBatch @relation(fields: [mfgBatchId], references: [id], onDelete: Cascade)

  issuedByName String?
  issueDate    DateTime?
  remarks      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines MfgMaterialIssueLine[]
}

// One row per material issued for a batch -- raw material or packaging
// material, discriminated by materialGroup. A new batch's Warehouse Issue
// pre-populates one line per standard packaging material
// (DEFAULT_PACKAGING_ISSUE_LINES); raw material lines are added by hand
// (formulations vary batch to batch).
model MfgMaterialIssueLine {
  id               String            @id @default(cuid())
  warehouseIssueId String
  warehouseIssue   MfgWarehouseIssue @relation(fields: [warehouseIssueId], references: [id], onDelete: Cascade)

  materialGroup     MfgMaterialGroup
  materialCode      String?
  description       String
  supplier          String?
  lotBatchNumber    String?
  expiryDate        DateTime?
  quantityRequested Float?
  quantityIssued    Float?
  quantityReturned  Float?
  sortOrder         Int

  @@index([warehouseIssueId])
}

model MfgBlending {
  id         String   @id @default(cuid())
  mfgBatchId String   @unique
  mfgBatch   MfgBatch @relation(fields: [mfgBatchId], references: [id], onDelete: Cascade)

  totalTheoreticalWeightKg Float?
  actualWeightKg           Float?
  blendBatchNumber         String?

  powderRemainingKg     Float?
  blenderResidueKg      Float?
  sieveLossKg           Float?
  dustLossKg            Float?
  spillagesKg           Float?
  qcSamplesQty          Float?
  retentionSamplesQty   Float?
  destroyedMaterialKg   Float?
  returnedToWarehouseKg Float?

  totalBlendProducedKg Float?

  blendedByName String?
  blendedAt     DateTime?
  remarks       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Mirrors the real "CAPSULE RECONCILIATION" paper form field-for-field.
// Derived figures (theoretical/produced/sample/reject capsule counts,
// blend accounted/unaccounted for, and the 4 reconciliation %s) are never
// stored -- computed at render time from these raw inputs, see
// lib/mfg-reconciliation.ts.
model MfgEncapsulation {
  id         String   @id @default(cuid())
  mfgBatchId String   @unique
  mfgBatch   MfgBatch @relation(fields: [mfgBatchId], references: [id], onDelete: Cascade)

  targetCapsuleFillWeightMg Float? // powder only
  avgCapsuleFullWeightMg    Float? // shell + powder

  issuedBulkBlendKg  Float?
  capsulesProducedKg Float? // weighed
  capsuleSamplesKg   Float?
  rejectCapsulesKg   Float?
  rejectPowderKg     Float?

  avgCapsuleFillWeightMg   Float? // measured, powder only (Capsule Properties)
  avgCapsuleLengthMm       Float?
  avgDisintegrationMinutes Int?
  avgDisintegrationSeconds Int?
  disintegrationResult     String? // "Pass" | "Fail"

  completedByName String?
  completedAt     DateTime?
  checkedByName   String?
  checkedAt       DateTime?
  comments        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Mirrors the real "BOTTLE RECONCILIATION" paper form field-for-field.
// Derived figures (capsules required/theoretical/used/reject, theoretical
// bottles, reject bottles/desiccants/caps, and the 5 reconciliation %s)
// are never stored -- computed at render time, see lib/mfg-reconciliation.ts.
model MfgBottling {
  id         String   @id @default(cuid())
  mfgBatchId String   @unique
  mfgBatch   MfgBatch @relation(fields: [mfgBatchId], references: [id], onDelete: Cascade)

  totalCapsuleBulkWeightKg Float?
  avgCapsuleFullWeightMg   Float?

  plannedQuantityBottles  Int?
  capsuleReceivedKg       Float?
  bottlesProduced         Int?
  bottleUsed              Int? // empty bottles issued
  desiccantsUsed          Int?
  capsUsed                Int?
  targetCapsulesPerBottle Int? // kept per-batch, not hardcoded

  completedByName String?
  completedAt     DateTime?
  checkedByName   String?
  checkedAt       DateTime?
  comments        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MfgXrayInspection {
  id         String   @id @default(cuid())
  mfgBatchId String   @unique
  mfgBatch   MfgBatch @relation(fields: [mfgBatchId], references: [id], onDelete: Cascade)

  bottlesReceived Int?
  bottlesScanned  Int?
  passed          Int?
  failed          Int?
  reworked        Int?
  destroyed       Int?
  released        Int?

  rejectMetalDetection   Int?
  rejectXrayFailure      Int?
  rejectUnderweight      Int?
  rejectOverweight       Int?
  rejectDamagedBottle    Int?
  rejectMissingCap       Int?
  rejectMissingDesiccant Int?

  inspectedByName String?
  inspectedAt     DateTime?
  remarks         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MfgPackaging {
  id         String   @id @default(cuid())
  mfgBatchId String   @unique
  mfgBatch   MfgBatch @relation(fields: [mfgBatchId], references: [id], onDelete: Cascade)

  packedBottles   Int?
  cartonsProduced Int?
  casesProduced   Int?

  packedByName String?
  packedAt     DateTime?
  remarks      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines MfgPackagingMaterialLine[]
}

// Fixed set of rows (one per MfgPackagingMaterialType), pre-populated when
// a batch's Packaging stage is first created -- not user-addable/removable,
// unlike MfgMaterialIssueLine.
model MfgPackagingMaterialLine {
  id          String       @id @default(cuid())
  packagingId String
  packaging   MfgPackaging @relation(fields: [packagingId], references: [id], onDelete: Cascade)

  materialType MfgPackagingMaterialType
  issued       Float?
  used         Float?
  damaged      Float?
  returned     Float?
  destroyed    Float?
  sortOrder    Int

  @@index([packagingId])
}

model MfgFinishedGoodsWarehouse {
  id         String   @id @default(cuid())
  mfgBatchId String   @unique
  mfgBatch   MfgBatch @relation(fields: [mfgBatchId], references: [id], onDelete: Cascade)

  finishedGoodsReceived Int?
  qaReleased            Boolean   @default(false)
  qaReleasedByName      String?
  qaReleasedAt          DateTime?
  storageLocation       String?
  warehouseBalance      Int?
  batchNumber           String?
  expiryDate            DateTime?
  remarks               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One-to-many: a batch can ship in parts, so each dispatch is its own
// append-only event row rather than fields on the batch itself.
model MfgDispatchEvent {
  id         String   @id @default(cuid())
  mfgBatchId String
  mfgBatch   MfgBatch @relation(fields: [mfgBatchId], references: [id], onDelete: Cascade)

  customer            String
  salesOrder          String?
  batchNumber         String?
  expiryDate          DateTime?
  casesDispatched     Int?
  bottlesDispatched   Int?
  dispatchDate        DateTime?
  remainingStockAfter Int?
  dispatchedByName    String?
  remarks             String?

  createdAt DateTime @default(now())

  @@index([mfgBatchId])
}

// =========================================================================
// QC SAMPLES — GMP/TGA-style quality-control sample lifecycle tracker.
// Adapted from a working reference implementation in a sibling project
// (eagle-labs-schedule), rewired onto this app's own conventions: real User
// relations instead of free-text actor names (matching Inspection's
// operatorId/supervisorId/qaId pattern), an optional link to this app's own
// MfgBatch instead of that project's BatchRecord, and the shared AuditLog/
// AuditAction convention instead of a bespoke audit table.
// =========================================================================

enum QcSampleType {
  FINISHED_PRODUCT
  STABILITY
  RETENTION
  INVESTIGATION
  COMPLAINT
}

enum QcSampleStatus {
  WAITING_COLLECTION
  COLLECTED
  WAITING_LAB
  IN_LABORATORY
  TESTING
  WAITING_RESULTS
  APPROVED
  REJECTED
  RETENTION
  EXPIRED
  DISPOSED
}

enum QcProductCategory {
  CAPSULE
  GUMMY
}

enum QcTestResult {
  PASS
  FAIL
}

enum QcAttachmentKind {
  COA
  LAB_REPORT
  PHOTO
  OTHER
}

/// sampleId (e.g. QC-2026-000124) is derived from `sequence` at creation and
/// then stored so it never changes even if the format logic does later.
model QcSample {
  id       String @id @default(cuid())
  sequence Int    @unique @default(autoincrement())
  sampleId String @unique

  productName String
  batchNumber String
  mfgBatchId  String?
  mfgBatch    MfgBatch? @relation(fields: [mfgBatchId], references: [id])

  manufacturingDate DateTime?
  expiryDate        DateTime?

  sampleType      QcSampleType
  productCategory QcProductCategory?
  quantity        Float
  unit            String

  collectedById  String?
  collectedBy    User?     @relation("QcSampleCollectedBy", fields: [collectedById], references: [id])
  collectionDate DateTime?
  collectionTime String?

  productionRoom        String?
  sampleStorageLocation String?
  storageTemperature    String?
  storageCondition      String?

  sentToLab          Boolean   @default(false)
  sentDate           DateTime?
  courierOrInternal  String?
  laboratoryName     String?
  laboratoryLocation String?
  receivedByQcId     String?
  receivedByQc       User?     @relation("QcSampleReceivedBy", fields: [receivedByQcId], references: [id])
  receivedDate       DateTime?

  status  QcSampleStatus @default(WAITING_COLLECTION)
  remarks String?

  createdById String
  createdBy   User     @relation("QcSampleCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  labTest         QcLabTest?
  retentionRecord QcRetentionRecord?
  attachments     QcSampleAttachment[]

  @@index([batchNumber])
  @@index([status])
  @@index([sampleType])
}

/// Real files (COA/lab report PDFs, product photos) for a sample — distinct
/// from the "COA Upload"/"Laboratory Report"/"Photographs" rows in the lab
/// test checklist below, which are just Pass/Fail + a text-field stand-in.
model QcSampleAttachment {
  id            String           @id @default(cuid())
  sampleId      String
  sample        QcSample         @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  kind          QcAttachmentKind
  url           String
  fileName      String
  fileSizeBytes Int
  uploadedById  String?
  uploadedBy    User?            @relation(fields: [uploadedById], references: [id])
  uploadedAt    DateTime         @default(now())

  @@index([sampleId])
}

/// Header record for a sample's lab testing pass — the checklist rows are
/// QcLabTestItem, generated from the CAPSULE/GUMMY template in
/// lib/qc-sample-defaults.ts for the sample's productCategory the moment
/// testing starts (the template lives in code, not the database).
model QcLabTest {
  id       String   @id @default(cuid())
  sampleId String   @unique
  sample   QcSample @relation(fields: [sampleId], references: [id], onDelete: Cascade)

  testedById String?
  testedBy   User?     @relation(fields: [testedById], references: [id])
  testedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items QcLabTestItem[]
}

/// One row of the product-category test checklist (e.g. section "Physical
/// Testing", parameter "Appearance"). Rows are always replaced wholesale
/// when results are recorded, never edited piecemeal.
model QcLabTestItem {
  id        String    @id @default(cuid())
  labTestId String
  labTest   QcLabTest @relation(fields: [labTestId], references: [id], onDelete: Cascade)

  section   String
  parameter String
  result    QcTestResult?
  details   String?
  sortOrder Int

  @@index([labTestId])
}

/// Where an approved sample physically lives after testing.
model QcRetentionRecord {
  id       String   @id @default(cuid())
  sampleId String   @unique
  sample   QcSample @relation(fields: [sampleId], references: [id], onDelete: Cascade)

  shelf             String?
  cabinet           String?
  boxNumber         String?
  position          String?
  quantityRemaining Float?
  opened            Boolean   @default(false)
  lastChecked       DateTime?
  expiryDate        DateTime?
  destroyDate       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiryDate])
}

// =========================================================================
// FORMULATION MANAGER — master recipes (organized into folders), scaled by
// the Batch Calculator to any production batch size with per-ingredient
// tolerance bands, plus a regulatory/safety/QC reference library that
// ingredient names are matched against by (normalized) name -- see
// lib/formulation-calc.ts and lib/ingredient-match.ts.
// =========================================================================

/// Groups formulations by product line / country / whatever grouping the
/// business uses (e.g. "AU Products", "NZ Products"). Deletable only when empty.
model FormulationFolder {
  id        String   @id @default(cuid())
  name      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())

  formulations Formulation[]
}

/// The master recipe header. baseBatchSize is never entered directly -- it's
/// the sum of every ingredient's baseQty, computed at save time (see
/// lib/actions/formulation-actions.ts).
model Formulation {
  id            String   @id @default(cuid())
  folderId      String
  productName   String
  baseBatchSize Float
  baseUnit      String   @default("kg")
  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  folder      FormulationFolder       @relation(fields: [folderId], references: [id])
  createdBy   User?                   @relation(fields: [createdById], references: [id])
  ingredients FormulationIngredient[]

  @@index([folderId])
}

/// One recipe line. ingredientName is free text, matched against the
/// Ingredient reference library by (normalized) name -- no FK, since the
/// same recipe text ("Vitamin C (Ascorbic Acid)") rarely matches a library
/// entry's canonical name byte-for-byte.
model FormulationIngredient {
  id               String  @id @default(cuid())
  formulationId    String
  order            Int
  rmNumber         String?
  ingredientName   String
  uin              String?
  baseQty          Float
  tolerancePct     Float   @default(2)
  controlStatus    String?
  changeControlRef String?
  approvedBy       String?
  comments         String?

  formulation Formulation @relation(fields: [formulationId], references: [id], onDelete: Cascade)

  @@index([formulationId])
}

/// Regulatory/safety/QC reference library, matched to formulation ingredient
/// lines by name only (see lib/ingredient-match.ts). Not required for a
/// formulation to exist -- a lookup that finds nothing just says so.
model Ingredient {
  id                 String    @id @default(cuid())
  name               String    @unique
  category           String?
  verified           Boolean   @default(false)
  verificationSource String?
  verifiedBy         String?
  verifiedAt         DateTime?

  // Per-authority regulatory status -- leave blank unless confirmed
  tgaStatus        String?
  apvmaStatus      String?
  fdaStatus        String?
  emaStatus        String?
  aicisStatus      String?
  regulatoryStatus String?

  // Safety
  safetyNotes         String?
  ghsClassification   String?
  signalWord          String?
  ppe                 String?
  handlingPrecautions String?

  // Quality specifications
  qcIdentity        String?
  qcAssay           String?
  qcMoisture        String?
  qcHeavyMetals     String?
  qcMicrobialLimits String?

  // Physical properties
  appearance   String?
  colour       String?
  odour        String?
  solubility   String?
  density      String?
  meltingPoint String?
  phValue      String?

  // Chemistry
  casNumber        String?
  molecularFormula String?
  molecularWeight  String?
  chemicalName     String?
  synonyms         String?

  // General use
  mainBenefit       String?
  usedFor           String?
  typicalDosage     String?
  storageConditions String?
  shelfLife         String?
  faq               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

// =========================================================================
// PRODUCTION STAGING OPERATIONS ("Drying Room") — a live floor-status board
// for physical staging bays (drying/curing/finishing) a batch physically
// sits in, plus a catch-all misc-storage tracker for anything not in a bay.
// Bay status is deliberately NOT its own stored field -- it's derived from
// whichever active batch's stage is most urgent (see lib/drying-room-defaults.ts's
// computeBayStatus), falling back to the bay's manually-set `purpose` only
// when it holds nothing active.
// =========================================================================

/// The bay's manually-set status when nothing active is in it. Trimmed from
/// the reference implementation's ~19 values down to just this floor's real
/// station types -- no polishing/coating/sorting stations here.
enum DryingBayPurpose {
  EMPTY
  DRYING
  WAITING_QC
  READY_FOR_POUCHING
  READY_FOR_PRODUCTION
  CLEANING_REQUIRED
  RND
  STORAGE
  SERVICE
  QUARANTINE
}

/// A batch's progress through the fixed staging pipeline. QC_HOLD loops back
/// to QC_SAMPLING (a failed QC sends it back for resampling, not backward
/// through the whole pipeline) -- see NEXT_STAGE / STAGE_ACTIONS.
enum DryingStage {
  RECEIVING
  DRYING
  ROTATION_REQUIRED
  CONTINUE_DRYING
  QC_SAMPLING
  QC_PENDING
  QC_APPROVED
  QC_HOLD
  WRAPPING
  READY_FOR_POUCHING
  POUCHING
  COMPLETE
}

enum TrolleyQcStatus {
  PENDING
  PASSED
  FAILED
}

model DryingBay {
  id                 String           @id @default(cuid())
  bayNumber          Int              @unique
  purpose            DryingBayPurpose @default(EMPTY)
  assignedEmployeeId String?
  assignedEmployee   User?            @relation("DryingBayAssignedEmployee", fields: [assignedEmployeeId], references: [id])
  department         String?
  comments           String?
  expectedFinishTime DateTime?
  updatedByName      String?
  updatedAt          DateTime         @updatedAt

  batches DryingBatch[]
}

/// bayId is nullable -- unassigned batches exist. baseBatchSize/etc. are not
/// used here; this is a physical staging record, not a recipe.
model DryingBatch {
  id                    String      @id @default(cuid())
  bayId                 String?
  bay                   DryingBay?  @relation(fields: [bayId], references: [id])
  productName           String
  batchNumber           String
  batchSize             Float
  batchSizeUnit         String      @default("kg")
  numberOfTrolleys      Int
  trayCount             Int
  dateEnteredDryingRoom DateTime
  dryingStartTime       DateTime?
  currentStage          DryingStage @default(RECEIVING)
  /// Bumped on every stage change -- this is what the alert timers (rotation
  /// overdue, waiting too long) key off, not createdAt/updatedAt.
  stageUpdatedAt        DateTime    @default(now())
  assignedEmployeeId    String?
  assignedEmployee      User?       @relation("DryingBatchAssignedEmployee", fields: [assignedEmployeeId], references: [id])
  /// 1/2/3 = gold/silver/bronze priority badge. Null = no priority set.
  priorityRank          Int?
  remarks               String?
  /// Null until done -- "active batches" everywhere is `where: { completedAt: null }`.
  completedAt           DateTime?
  updatedByName         String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  trolleys DryingTrolley[]

  @@index([bayId])
}

/// The physical unit that actually gets rotated/wrapped/QC'd. Auto-created
/// in bulk (one row per numberOfTrolleys) when a batch is created.
model DryingTrolley {
  id                 String          @id @default(cuid())
  batchId            String
  batch              DryingBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  trolleyNumber      Int
  quantity           Float?
  trayCount          Int?
  wrapped            Boolean         @default(false)
  rotationCompleted  Boolean         @default(false)
  qcStatus           TrolleyQcStatus @default(PENDING)
  assignedEmployeeId String?
  assignedEmployee   User?           @relation("DryingTrolleyAssignedEmployee", fields: [assignedEmployeeId], references: [id])
  remarks            String?

  @@index([batchId])
}

/// A much looser freeform record than DryingBatch -- stuff being tracked
/// that isn't physically in a bay. No workflow, no enum, just a flat list.
model MiscStorageItem {
  id             String   @id @default(cuid())
  product        String
  batchNumber    String?
  quantityLabel  String
  storageType    String?
  status         String?
  requiredAction String?
  location       String?
  remarks        String?
  updatedByName  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
